# Optional: external ATS URL for “Go to ATS” on the job board when logged in as HR.
# If unset, “Go to ATS” navigates to /hr (built-in HR dashboard).
VITE_ATS_URL=

# Public careers site origin used in CV Analyser “Sent invite” links (candidate interview URLs).
# Local dev: http://localhost:3000
# Production build / production deploy: https://career.indiraivf.in
# If unset, invite links use the browser tab origin (window.location.origin).
# VITE_PUBLIC_APP_URL=https://career.indiraivf.in
