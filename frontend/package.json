{
  "name": "swarhr-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "favicons": "node scripts/generate-favicons.mjs",
    "typecheck": "tsc --noEmit",
    "extract:legacy": "node scripts/extract-legacy.mjs && node scripts/fix-legacy.mjs",
    "split:components": "node scripts/split-from-legacy.mjs && node scripts/convert-helpers.mjs && node scripts/wire-imports.mjs",
    "split:from-legacy": "node scripts/split-from-legacy.mjs && node scripts/convert-helpers.mjs && node scripts/wire-imports.mjs",
    "lint": "eslint src",
    "test": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.8",
    "jspdf": "^4.2.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
