ANTHROPIC_API_KEY=sk-ant-api03-replace-me
PORT=3001

# Comma-separated extra CORS origins (e.g. production careers site). Default includes localhost dev ports.
# CORS_ORIGINS=https://career.example.com,https://www.example.com

# CV Analyser (HR bulk upload — files stored as BYTEA in cv_analysis_cache)
CV_ANALYSER_MAX_FILES=20
CV_ANALYSER_MAX_FILE_MB=5
CV_ANALYSER_RATE_LIMIT=5
# If PDF plain-text extract is shorter than this (chars), send full PDF to Claude as a document (visual + text). Lower = more vision calls, higher cost.
CV_ANALYSER_PDF_VISION_TEXT_THRESHOLD=500

# Required in production — signs session JWTs for /api/auth/* and /api/me
# JWT_SECRET=change-me-to-a-long-random-string

# Voice bot (service token for GET/POST /api/voice-bot/* — timing-safe compare; never log)
# VOICE_BOT_SERVICE_TOKEN=

# Optional JSON array of question strings (min 10 chars each); overrides default 5 fallback questions when job has none
# VOICE_BOT_FALLBACK_QUESTIONS=["Tell me about yourself...","Why this role?"]

# Voice-bot AI follow-up behaviour (asked between role-specific HR script and closing).
# INTERVIEW_DIFFICULTY: easy | medium | hard (default medium). Drives how deeply Claude probes the candidate.
#   easy   = role basics, daily duties, fundamentals.
#   medium = standard role competencies, situational judgement, single-step problem solving.
#   hard   = senior-level multi-step scenarios, edge cases, behavioural STAR with complications.
# INTERVIEW_AI_FOLLOWUP_COUNT: integer 1–30 (default 12). How many AI follow-ups Swar asks. Capped server-side.
# INTERVIEW_DIFFICULTY=medium
# INTERVIEW_AI_FOLLOWUP_COUNT=12

# ── PostgreSQL: PG_* is preferred when set (RDS-friendly). Else DATABASE_URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=SwarHR
PG_USER=aideveloper
PG_PASSWORD=your-password

# SSL: auto for *.rds.amazonaws.com; for localhost, auto when PG_PORT≠5432 or PG_TUNNEL=true
# PG_SSL=true
# PG_SSL=false
# PG_TUNNEL=true
# PG_SSL_REJECT_UNAUTHORIZED=true
