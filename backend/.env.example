ANTHROPIC_API_KEY=sk-ant-api03-replace-me
PORT=3001

# CORS: in development, localhost:3000/5173 are allowed automatically.
# In production (NODE_ENV=production), ONLY these origins are allowed — required for browser access.
# CORS_ORIGINS=https://career.example.com,https://www.example.com

# JSON body size limits (MB). Large limit applies to /api/me, /api/state, /api/talent-pool, /api/voice-bot
# JSON_BODY_LIMIT_MB=5
# JSON_BODY_LIMIT_LARGE_MB=50

# CV Analyser (HR bulk upload — files stored as BYTEA in cv_analysis_cache)
CV_ANALYSER_MAX_FILES=20
CV_ANALYSER_MAX_FILE_MB=5
CV_ANALYSER_RATE_LIMIT=5
# If PDF plain-text extract is shorter than this (chars), send full PDF to Claude as a document (visual + text). Lower = more vision calls, higher cost.
CV_ANALYSER_PDF_VISION_TEXT_THRESHOLD=500

# Required in production — signs session JWTs (also stored in HttpOnly cookie swar_token)
# JWT_SECRET=change-me-to-a-long-random-string

# Session length in seconds (default 86400 = 24 hours for HR and candidates)
# JWT_EXPIRES_HR_SEC=86400
# JWT_EXPIRES_CAND_SEC=86400

# Public candidate registration: true | false (default: true in dev, false in production)
# REGISTRATION_ENABLED=true

# HttpOnly auth cookie (production HTTPS: AUTH_COOKIE_SECURE=true; cross-site UI+API: AUTH_COOKIE_CROSS_SITE=true)
# Local dev on http://localhost: AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_CROSS_SITE=false
# AUTH_COOKIE_SAME_SITE=Lax

# Voice bot (service token for GET/POST /api/voice-bot/* — timing-safe compare; never log)
# VOICE_BOT_SERVICE_TOKEN=
# Optional comma-separated IPs allowed to use service token
# VOICE_BOT_ALLOWED_IPS=

# Optional JSON array of question strings (min 10 chars each); overrides default 5 fallback questions when job has none
# VOICE_BOT_FALLBACK_QUESTIONS=["Tell me about yourself...","Why this role?"]

# Voice-bot AI follow-up behaviour (asked between role-specific HR script and closing).
# INTERVIEW_DIFFICULTY: easy | medium | hard (default medium). Drives how deeply Claude probes the candidate.
#   easy   = role basics, daily duties, fundamentals.
#   medium = standard role competencies, situational judgement, single-step problem solving.
#   hard   = senior-level multi-step scenarios, edge cases, behavioural STAR with complications.
# INTERVIEW_AI_FOLLOWUP_COUNT: integer 1–30 (default 12). How many AI follow-ups Swar asks. Capped server-side.
# INTERVIEW_DIFFICULTY=medium
# INTERVIEW_AI_FOLLOWUP_COUNT=12

# ── PostgreSQL: PG_* is preferred when set (RDS-friendly). Else DATABASE_URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=SwarHR
PG_USER=aideveloper
PG_PASSWORD=your-password

# SSL: auto for *.rds.amazonaws.com; for localhost, auto when PG_PORT≠5432 or PG_TUNNEL=true
# PG_SSL=true
# PG_SSL=false
# PG_TUNNEL=true
# PG_SSL_REJECT_UNAUTHORIZED=true
# Connection pool size (default 10)
# PG_POOL_MAX=20

# ── S3 CV / resume storage (recommended for production) ──
# When configured, uploads go to S3; PostgreSQL stores metadata + s3_key only.
# If S3 PutObject fails (e.g. IAM), fall back to base64 in PostgreSQL (default: true).
# Set S3_ATTACHMENTS_FALLBACK_TO_DB=false in production once IAM is correct.
S3_ATTACHMENTS_FALLBACK_TO_DB=true
S3_ATTACHMENTS_BUCKET=swar-hr
S3_ATTACHMENTS_KEY_PREFIX=
# Optional public CDN/base URL — only used when objects are world-readable (see below)
# S3_ATTACHMENTS_PUBLIC_BASE_URL=
# Set to true only if the bucket/CDN allows anonymous GET (otherwise presigned URLs are used)
# S3_ATTACHMENTS_OBJECTS_ARE_PUBLIC=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
